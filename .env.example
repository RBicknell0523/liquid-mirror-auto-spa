# Google Apps Script Web App URL that appends Contact form submissions to a
# Google Sheet. See app/api/contact/route.ts. Deploy the Apps Script as a Web
# App (Execute as: Me, Who has access: Anyone) and paste the resulting
# /exec URL here in your own .env.local (never commit the real value).
GOOGLE_SHEETS_WEBHOOK_URL=

# Square checkout. Get these from the Square Developer Dashboard
# (developer.squareup.com) — Application ID and Access Token are on your
# app's Credentials page (use the Sandbox tab while testing); Location ID
# is under Sandbox Test Accounts > your test account > Locations. Never
# commit the real values.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
